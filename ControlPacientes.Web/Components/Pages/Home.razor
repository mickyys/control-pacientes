@page "/"
@using ControlPacientes.Business.Services
@inject IPacienteService PacienteService
@inject IFichaMedicaService FichaMedicaService

<PageTitle>Control de Pacientes</PageTitle>

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4">Control de Pacientes</h1>
            <p class="lead">Sistema de Gestión Médica Offline</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <NavLink href="pacientes" class="card h-100 text-decoration-none text-dark hover-shadow">
                <div class="card-body text-center">
                    <div style="font-size: 48px; margin-bottom: 10px;">👥</div>
                    <h5 class="card-title">Gestionar Pacientes</h5>
                    <p class="card-text text-muted">Crear, editar y buscar pacientes</p>
                </div>
            </NavLink>
        </div>

        <div class="col-md-4">
            <NavLink href="fichas" class="card h-100 text-decoration-none text-dark hover-shadow">
                <div class="card-body text-center">
                    <div style="font-size: 48px; margin-bottom: 10px;">📋</div>
                    <h5 class="card-title">Fichas Médicas</h5>
                    <p class="card-text text-muted">Crear y actualizar historiales</p>
                </div>
            </NavLink>
        </div>

        <div class="col-md-4">
            <div class="card h-100 hover-shadow">
                <div class="card-body text-center">
                    <div style="font-size: 48px; margin-bottom: 10px;">📊</div>
                    <h5 class="card-title">Reportes</h5>
                    <p class="card-text text-muted">Ver estadísticas y reportes</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">ℹ️ Información del Sistema</h5>
                    <p class="card-text">
                        Total de pacientes: <strong>@totalPacientes</strong><br />
                        Total de fichas médicas: <strong>@totalFichas</strong>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-shadow {
        transition: box-shadow 0.3s ease, transform 0.3s ease;
        cursor: pointer;
    }

    .hover-shadow:hover {
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        transform: translateY(-2px);
    }

    a.hover-shadow {
        text-decoration: none;
        color: inherit;
    }
</style>

@code {
    private int totalPacientes = 0;
    private int totalFichas = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var pacientes = await PacienteService.ObtenerTodosPacientesAsync();
            totalPacientes = pacientes?.Count ?? 0;

            var fichas = await FichaMedicaService.ObtenerTodasFichasAsync();
            totalFichas = fichas?.Count ?? 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar datos: {ex.Message}");
        }
    }
}
