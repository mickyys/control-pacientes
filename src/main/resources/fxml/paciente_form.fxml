<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.controlpacientes.ui.controller.PacienteFormController"
      spacing="20" styleClass="content-area" prefWidth="600">
    <padding>
        <Insets top="30" left="30" right="30" bottom="30"/>
    </padding>

    <Text fx:id="titleText" text="Nuevo Paciente" styleClass="section-title"/>

    <GridPane hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="RUT"/>
            <TextField fx:id="rutField" promptText="12.345.678-9" styleClass="search-field"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Edad"/>
            <Spinner fx:id="edadSpinner" maxWidth="Infinity" styleClass="search-field"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Nombre"/>
            <TextField fx:id="nombreField" styleClass="search-field"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Apellido"/>
            <TextField fx:id="apellidoField" styleClass="search-field"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Email"/>
            <TextField fx:id="emailField" styleClass="search-field"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Teléfono"/>
            <TextField fx:id="telefonoField" styleClass="search-field"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3">
            <Label text="Ciudad"/>
            <TextField fx:id="ciudadField" styleClass="search-field"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <Label text="Dirección"/>
            <TextField fx:id="direccionField" styleClass="search-field"/>
        </VBox>

        <VBox spacing="5" GridPane.columnSpan="2" GridPane.rowIndex="4">
            <Label text="Notas Clínicas"/>
            <TextArea fx:id="notasField" prefHeight="100" styleClass="search-field"/>
        </VBox>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" fx:id="btnCancelar" onAction="#handleCancel" styleClass="btn-secondary"/>
        <Button text="Guardar Paciente" fx:id="btnGuardar" onAction="#handleSave" styleClass="btn-primary"/>
    </HBox>
</VBox>
