<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.controlpacientes.ui.controller.FichasListController"
      spacing="0" styleClass="content-area" VBox.vgrow="ALWAYS">
    
    <padding>
        <Insets top="30.0" left="40.0" right="40.0" bottom="30.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Text text="Fichas Médicas" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <HBox spacing="10.0" style="-fx-padding: 20 0;">
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Buscar Fichas" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
            <HBox spacing="10.0">
                <DatePicker fx:id="searchFecha" promptText="Seleccionar fecha..." prefWidth="200" styleClass="search-field"/>
                <TextField fx:id="searchPaciente" promptText="Paciente..." prefWidth="200" styleClass="search-field"/>
                <TextField fx:id="searchDiagnostico" promptText="Diagnóstico..." prefWidth="200" styleClass="search-field"/>
            </HBox>
        </VBox>
        <VBox spacing="8" style="-fx-alignment: bottom-right;">
            <Region VBox.vgrow="ALWAYS"/>
            <HBox spacing="10.0">
                <Button text="Buscar" styleClass="btn-secondary" onAction="#handleSearch"/>
                <Button text="Limpiar" styleClass="btn-secondary" onAction="#handleClearSearch"/>
            </HBox>
        </VBox>
    </HBox>

    <TableView fx:id="fichasTable" VBox.vgrow="ALWAYS" styleClass="modern-table" style="-fx-margin-top: 20;">
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150.0" sortable="true"/>
            <TableColumn fx:id="colPaciente" text="Paciente" prefWidth="200.0" sortable="true"/>
            <TableColumn fx:id="colProfesional" text="Profesional" prefWidth="200.0" sortable="true"/>
            <TableColumn fx:id="colDiagnostico" text="Diagnóstico" prefWidth="300.0" sortable="true"/>
            <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="150.0" sortable="false"/>
        </columns>
    </TableView>
</VBox>
