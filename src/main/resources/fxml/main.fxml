<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.controlpacientes.ui.controller.MainController"
      prefHeight="900.0" prefWidth="1400.0"
      spacing="0" styleClass="root-container">

    <!-- Menu Bar -->
    <MenuBar>
        <menus>
            <Menu text="Herramientas">
                <items>
                    <MenuItem text="Exportar a Excel" onAction="#handleExportarExcel"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Acerca de" onAction="#handleAbout"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Salir" onAction="#handleExit"/>
                </items>
            </Menu>
        </menus>
    </MenuBar>   

    <!-- Main Content Area - 2 Columns Layout -->
    <HBox fx:id="mainContentHBox" VBox.vgrow="ALWAYS" spacing="15.0" styleClass="content-area">
        <padding>
            <Insets top="15.0" left="15.0" right="15.0" bottom="15.0"/>
        </padding>

        <!-- LEFT COLUMN: Patient Information, Medical Records and Medications -->
        <VBox fx:id="leftColumn" spacing="15.0" HBox.hgrow="ALWAYS" prefWidth="750.0">

            <!-- PATIENT INFORMATION PANEL - 2 COLUMNS -->
            <VBox styleClass="panel-compact" spacing="8.0">
                <padding>
                    <Insets top="8.0" bottom="8.0" left="8.0" right="8.0"/>
                </padding>
              
                 <HBox spacing="10.0" alignment="CENTER_LEFT">
                          <Label text="Información del Paciente" styleClass="panel-title"/>
                          <Region HBox.hgrow="ALWAYS"/>
                          <Button text="+ Nuevo Paciente" fx:id="btnNewPaciente" onAction="#handleNewPaciente" styleClass="btn-sm-primary"/>
                 </HBox>

                <!-- Row 1: RUT, Nombre, Apellido -->
                <HBox spacing="5.0" fx:id="pacienteColumnsContainer">
                    <!-- Column 1: RUT -->
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="RUT" styleClass="field-label"/>
                        <TextField fx:id="tfPacienteRut" promptText="Ej: 12345678-9" styleClass="input-field" disable="true"/>
                    </VBox>

                    <!-- Column 2: Nombre -->
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="Nombre" styleClass="field-label"/>
                        <TextField fx:id="tfPacienteNombre" promptText="Nombre completo" styleClass="input-field" disable="true"/>
                    </VBox>

                    <!-- Column 3: Apellido -->
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="Apellido" styleClass="field-label"/>
                        <TextField fx:id="tfPacienteApellido" promptText="Apellido" styleClass="input-field" disable="true"/>
                    </VBox>
                </HBox>

                <!-- Row 2: Teléfono, Email, Dirección, Ciudad -->
                <HBox spacing="5.0">
                    <!-- Column 1: Teléfono -->
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="Teléfono" styleClass="field-label"/>
                        <TextField fx:id="tfPacienteTelefono" promptText="+56 9 9999 9999" styleClass="input-field" disable="true"/>
                    </VBox>

                    <!-- Column 2: Email -->
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="Email" styleClass="field-label"/>
                        <TextField fx:id="tfPacienteEmail" promptText="correo@ejemplo.com" styleClass="input-field" disable="true"/>
                    </VBox>

                    <!-- Column 3: Dirección -->
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="Dirección" styleClass="field-label"/>
                        <TextField fx:id="tfPacienteDireccion" promptText="Dirección completa" styleClass="input-field" disable="true"/>
                    </VBox>

                    <!-- Column 4: Ciudad -->
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="Ciudad" styleClass="field-label"/>
                        <TextField fx:id="tfPacienteCiudad" promptText="Ciudad de residencia" styleClass="input-field" disable="true"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- MEDICAL RECORDS AND MEDICATIONS PANEL -->
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">

                <!-- MEDICAL RECORDS SECTION -->
                <VBox styleClass="panel-compact" spacing="8.0" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="8.0" bottom="8.0" left="8.0" right="8.0"/>
                    </padding>
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Label text="Fichas Médicas" styleClass="panel-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Limpiar" fx:id="btnFichaLimpiar" onAction="#handleFichaLimpiar" styleClass="btn-secondary"/>
                        <Button text="Guardar" fx:id="btnFichaGuardar" onAction="#handleFichaGuardar" styleClass="btn-primary"/>
                    </HBox>

                   
                    <Label text="Historial de Fechas" styleClass="field-label"/>
                   <ComboBox fx:id="cbFichaFechas" minWidth="150" minHeight="32"/>

                    <Label text="Motivo de Consulta" styleClass="field-label"/>
                    <TextArea fx:id="taMotivoconsulta" wrapText="true" prefHeight="80.0" styleClass="no-border-textarea" promptText="Describa el motivo de la consulta..." VBox.vgrow="ALWAYS"/>

                    <Label text="Síntesis Diagnóstica" styleClass="field-label"/>
                    <TextArea fx:id="taSintesisDiagnostica" wrapText="true" prefHeight="80.0" styleClass="no-border-textarea" promptText="Síntesis del diagnóstico..." VBox.vgrow="ALWAYS"/>
                </VBox>

                <!-- MEDICATIONS SECTION -->
                <VBox styleClass="panel-compact" spacing="8.0" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" prefWidth="240.0">
                    <padding>
                        <Insets top="8.0" bottom="8.0" left="8.0" right="8.0"/>
                    </padding>
                    <Label text="Medicamentos" styleClass="panel-title"/>

                    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                        <VBox fx:id="vbMedicamentos" spacing="6.0">
                            <padding>
                                <Insets top="5.0" bottom="5.0" left="5.0" right="5.0"/>
                            </padding>
                        </VBox>
                    </ScrollPane>
                </VBox>
            </HBox>
        </VBox>

        <!-- RIGHT COLUMN: Search and Patient List -->
        <VBox fx:id="rightColumn" spacing="15.0" HBox.hgrow="ALWAYS" prefWidth="400.0">
            <!-- SEARCH PANEL -->
            <VBox styleClass="panel" spacing="10.0">
                <padding>
                    <Insets top="15.0" bottom="15.0" left="15.0" right="15.0"/>
                </padding>
                <Label text="Buscador de Pacientes" styleClass="panel-title"/>

                <HBox spacing="15.0" fx:id="searchColumnsContainer">
                    <!-- Column 1 -->
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="RUT" styleClass="field-label"/>
                        <TextField fx:id="tfBuscaRut" promptText="Buscar por RUT..." styleClass="input-field"/>
                    </VBox>

                    <!-- Column 2 -->
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="Nombre" styleClass="field-label"/>
                        <TextField fx:id="tfBuscaNombre" promptText="Buscar por nombre..." styleClass="input-field"/>
                    </VBox>

                    <!-- Column 3 -->
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="Ciudad" styleClass="field-label"/>
                        <TextField fx:id="tfBuscaCiudad" promptText="Buscar por ciudad..." styleClass="input-field"/>

                        <Label text="Año Última Visita" styleClass="field-label"/>
                        <TextField fx:id="tfBuscaAno" promptText="Ej: 2025" styleClass="input-field"/>
                    </VBox>
                </HBox>

                <Button text="Buscar" fx:id="btnBuscar" onAction="#handleBuscar" styleClass="btn-primary" maxWidth="Infinity"/>
                <Button text="Limpiar Búsqueda" fx:id="btnBuscadorLimpiar" onAction="#handleBuscadorLimpiar" styleClass="btn-secondary" maxWidth="Infinity"/>

                <HBox spacing="5.0" alignment="CENTER_LEFT">
                    <Label text="Resultados:" styleClass="field-label"/>
                    <Label fx:id="lblResultados" text="0" styleClass="result-count"/>
                </HBox>
            </VBox>

            <!-- PATIENTS LIST PANEL -->
            <VBox styleClass="panel" spacing="10.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="15.0" bottom="15.0" left="15.0" right="15.0"/>
                </padding>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Listado de Pacientes" styleClass="panel-title"/>
                </HBox>
                <TableView fx:id="tvPacientes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="RUT" prefWidth="90.0" fx:id="tcRut"/>
                        <TableColumn text="Nombre" prefWidth="100.0" fx:id="tcNombre"/>
                        <TableColumn text="Apellido" prefWidth="100.0" fx:id="tcApellido"/>
                        <TableColumn text="Ciudad" prefWidth="90.0" fx:id="tcCiudad"/>
                        <TableColumn text="Última Visita" prefWidth="120.0" fx:id="tcUltimaVisita"/>
                        <TableColumn text="Eliminar" prefWidth="80.0" fx:id="tcEliminar"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </HBox>
</VBox>
