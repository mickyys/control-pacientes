<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.controlpacientes.ui.controller.MedicamentoDialogController"
      spacing="15" styleClass="content-area" prefWidth="500">
    <padding>
        <Insets top="20" left="20" right="20" bottom="20"/>
    </padding>

    <Label text="Agregar Medicamento" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>

    <VBox spacing="5">
        <Label text="Nombre del Medicamento *"/>
        <TextField fx:id="nombreField" promptText="Ej: Paracetamol" styleClass="search-field" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Dosis *"/>
        <TextField fx:id="dosisField" promptText="Ej: 500 mg" styleClass="search-field" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Frecuencia *"/>
        <TextField fx:id="frecuenciaField" promptText="Ej: Cada 8 horas" styleClass="search-field" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Duración *"/>
        <TextField fx:id="duracionField" promptText="Ej: 7 días" styleClass="search-field" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Cantidad a Recetar"/>
        <TextField fx:id="cantidadField" promptText="Ej: 1" styleClass="search-field" maxWidth="Infinity"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#handleCancel" styleClass="btn-secondary"/>
        <Button text="Agregar" onAction="#handleAgregar" styleClass="btn-primary" fx:id="btnAgregar"/>
    </HBox>
</VBox>
