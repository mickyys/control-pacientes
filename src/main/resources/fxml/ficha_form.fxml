<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.controlpacientes.ui.controller.FichaMedicaFormController"
      spacing="15" styleClass="content-area" prefWidth="900" prefHeight="900">
    <padding>
        <Insets top="25" left="30" right="30" bottom="25"/>
    </padding>

    <Text fx:id="titleText" text="Nueva Ficha Médica" styleClass="section-title"/>

    <!-- SECCIÓN INFORMACIÓN DEL PACIENTE -->
    <TitledPane fx:id="pacienteTitledPane" text="Información del Paciente" expanded="true" collapsible="false" style="-fx-padding: 10;">
        <GridPane hgap="15" vgap="10">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>

            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="RUT" style="-fx-font-weight: bold;"/>
                <TextField fx:id="pacienteRutField" maxWidth="Infinity" disable="true" styleClass="search-field"/>
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Nombre" style="-fx-font-weight: bold;"/>
                <TextField fx:id="pacienteNombreField" maxWidth="Infinity" styleClass="search-field"/>
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label text="Apellido" style="-fx-font-weight: bold;"/>
                <TextField fx:id="pacienteApellidoField" maxWidth="Infinity" styleClass="search-field"/>
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="0">
                <Label text="Edad" style="-fx-font-weight: bold;"/>
                <TextField fx:id="pacienteEdadField" maxWidth="Infinity" styleClass="search-field"/>
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="Email" style="-fx-font-weight: bold;"/>
                <TextField fx:id="pacienteEmailField" maxWidth="Infinity" styleClass="search-field"/>
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="Teléfono" style="-fx-font-weight: bold;"/>
                <TextField fx:id="pacienteTelefonoField" maxWidth="Infinity" styleClass="search-field"/>
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="1">
                <Label text="Ciudad" style="-fx-font-weight: bold;"/>
                <TextField fx:id="pacienteCiudadField" maxWidth="Infinity" styleClass="search-field"/>
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="1">
                <Label text="Dirección" style="-fx-font-weight: bold;"/>
                <TextField fx:id="pacienteDireccionField" maxWidth="Infinity" styleClass="search-field"/>
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="2">
                <Label text="Notas Clínicas" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="pacienteNotasField" prefHeight="80" wrapText="true" styleClass="search-field"/>
            </VBox>
        </GridPane>
    </TitledPane>

    <Separator/>

    <GridPane hgap="15" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Fecha de Atención"/>
            <DatePicker fx:id="fechaAtencionPicker" maxWidth="Infinity" styleClass="search-field"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Profesional"/>
            <TextField fx:id="profesionalField" maxWidth="Infinity" styleClass="search-field"/>
        </VBox>

        <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1" VBox.vgrow="ALWAYS">
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Label text="Motivo de la Consulta"/>
                <TextArea fx:id="motivoField" prefHeight="450" wrapText="true" styleClass="search-field" VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Label text="Diagnóstico"/>
                <TextArea fx:id="diagnosticoField" prefHeight="450" wrapText="true" styleClass="search-field" VBox.vgrow="ALWAYS"/>
            </VBox>
        </VBox>

        <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="medicamentosLabel" text="Medicamentos (0)" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="+ Agregar Medicamento" styleClass="btn-sm-outline" onAction="#handleAddMedicamento"/>
            </HBox>

            <TableView fx:id="medicamentosTable" VBox.vgrow="ALWAYS" editable="true" styleClass="modern-table" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colMedNombre" text="Medicamento"/>
                    <TableColumn fx:id="colMedAcciones" text="Acciones" minWidth="80" maxWidth="80" resizable="false"/>
                </columns>
            </TableView>
        </VBox>
    </GridPane>

    <Separator />

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Descargar PDF" onAction="#handleDownloadPDF" styleClass="btn-secondary"/>
        <Button text="Imprimir" onAction="#handlePrint" styleClass="btn-secondary"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Cancelar" onAction="#handleCancel" styleClass="btn-secondary"/>
        <Button text="Guardar Ficha" onAction="#handleSave" styleClass="btn-primary" fx:id="btnGuardar"/>
    </HBox>
</VBox>
