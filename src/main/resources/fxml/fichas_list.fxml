<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.controlpacientes.ui.controller.FichaMedicaListController"
      spacing="0" styleClass="content-area" prefHeight="600.0" prefWidth="900.0">
    
    <padding>
        <Insets top="30.0" left="40.0" right="40.0" bottom="30.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <VBox>
            <Text text="Fichas Médicas" styleClass="section-title"/>
            <Text fx:id="pacienteNameText" text="Paciente: Cargando..." style="-fx-fill: #6c757d; -fx-font-size: 14px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnNewFicha" text="+ Nueva Ficha" styleClass="btn-primary" onAction="#handleNewFicha"/>
    </HBox>

    <HBox spacing="10.0" style="-fx-padding: 20 0;">
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Buscar Fichas" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
            <HBox spacing="10.0">
                <TextField fx:id="searchFecha" promptText="Fecha (dd/MM/yyyy)..." prefWidth="170" styleClass="search-field"/>
                <TextField fx:id="searchPaciente" promptText="Paciente..." prefWidth="170" styleClass="search-field"/>
                <TextField fx:id="searchDiagnostico" promptText="Diagnóstico..." prefWidth="170" styleClass="search-field"/>
            </HBox>
        </VBox>
        <VBox spacing="8" style="-fx-alignment: bottom-right;">
            <Region VBox.vgrow="ALWAYS"/>
            <HBox spacing="10.0">
                <Button text="Buscar" styleClass="btn-secondary" onAction="#handleSearch"/>
                <Button text="Limpiar" styleClass="btn-secondary" onAction="#handleClearSearch"/>
            </HBox>
        </VBox>
    </HBox>

    <TableView fx:id="fichasTable" VBox.vgrow="ALWAYS" styleClass="modern-table" style="-fx-margin-top: 20;">
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150.0"/>
            <TableColumn fx:id="colPaciente" text="Paciente" prefWidth="200.0"/>
            <TableColumn fx:id="colProfesional" text="Profesional" prefWidth="200.0"/>
            <TableColumn fx:id="colDiagnostico" text="Diagnóstico" prefWidth="250.0"/>
            <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="300.0"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
        <Button text="Cerrar" styleClass="btn-secondary" onAction="#handleClose"/>
    </HBox>
</VBox>
