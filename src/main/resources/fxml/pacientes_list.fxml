<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.controlpacientes.ui.controller.PacientesListController"
      spacing="0" styleClass="content-area" VBox.vgrow="ALWAYS">
    
    <padding>
        <Insets top="30.0" left="40.0" right="40.0" bottom="30.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Text text="Listado de Pacientes" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="+ Nuevo Paciente" styleClass="btn-primary" onAction="#handleNewPaciente"/>
    </HBox>

    <HBox spacing="10.0" style="-fx-padding: 20 0;">
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Buscar Pacientes" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
            <HBox spacing="10.0">
                <TextField fx:id="searchNombre" promptText="Nombre..." prefWidth="200" styleClass="search-field"/>
                <TextField fx:id="searchRut" promptText="RUT..." prefWidth="200" styleClass="search-field"/>
                <TextField fx:id="searchEmail" promptText="Email..." prefWidth="200" styleClass="search-field"/>
                <TextField fx:id="searchCiudad" promptText="Ciudad..." prefWidth="200" styleClass="search-field"/>
            </HBox>
        </VBox>
        <VBox spacing="8" style="-fx-alignment: bottom-right;">
            <Region VBox.vgrow="ALWAYS"/>
            <HBox spacing="10.0">
                <Button text="Buscar" styleClass="btn-secondary" onAction="#handleSearch"/>
                <Button text="Limpiar" styleClass="btn-secondary" onAction="#handleClearSearch"/>
            </HBox>
        </VBox>
    </HBox>

    <TableView fx:id="pacientesTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
        <columns>
            <TableColumn fx:id="colRut" text="RUT" prefWidth="120.0"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="250.0"/>
            <TableColumn fx:id="colEdad" text="Edad" prefWidth="80.0"/>
            <TableColumn fx:id="colTelefono" text="Celular" prefWidth="150.0"/>
            <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="150.0"/>
            <TableColumn fx:id="colUltimaVisita" text="Última Visita" prefWidth="150.0"/>
            <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="150.0"/>
        </columns>
    </TableView>
</VBox>
