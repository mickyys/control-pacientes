<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- 
    Este archivo personaliza la configuración de jpackage para Windows Installer (MSI).
    Las variables se proporcionan automáticamente por jpackage.
  -->

  <Product Id="$(var.JpProductCode)" 
           Name="$(var.JpAppName)" 
           Language="1033" 
           Version="$(var.JpAppVersion)" 
           UpgradeCode="$(var.JpProductUpgradeCode)" 
           Manufacturer="$(var.JpAppVendor)">

    <Package InstallerVersion="200" 
             Compressed="yes" 
             InstallScope="perMachine" 
             Description="$(var.JpAppDescription)"/>

    <!-- Permitir upgrade automático -->
    <MajorUpgrade AllowDowngrades="yes" 
                  AllowSameVersionUpgrades="yes"/>

    <Media Id="1" 
           Cabinet="$(var.JpAppName).cab" 
           EmbedCab="yes"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="$(var.JpAppName)"/>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="APPMENUFOLDER" Name="$(var.JpAppName)"/>
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop"/>
    </Directory>

    <!-- Feature principal -->
    <Feature Id="ProductFeature" 
             Title="$(var.JpAppName)" 
             Level="1" 
             ConfigurableDirectory="INSTALLFOLDER"/>

    <!-- Interfaz de usuario estándar -->
    <UIRef Id="WixUI_InstallDir"/>
    
    <!-- Variables para la interfaz de usuario -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.JpConfigDir)\LICENSE" Overridable="yes"/>

  </Product>

</Wix>
