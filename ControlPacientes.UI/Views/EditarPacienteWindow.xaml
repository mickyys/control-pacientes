<Window x:Class="ControlPacientes.UI.Views.EditarPacienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Paciente" Height="650" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Información del Paciente" FontSize="18" FontWeight="Bold" 
                   Foreground="#1E3A8A" Margin="0,0,0,15"/>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,15">
            <Border Background="White" Padding="20">
                <StackPanel>
                
                <!-- RUT -->
                <StackPanel>
                    <TextBlock Text="RUT *" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="RutBox" Padding="8" Text="" Background="#F9FAFB"/>
                </StackPanel>

                <!-- Nombre y Apellido -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Nombre *" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="NombreBox" Padding="8" Background="#F9FAFB"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Apellido *" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ApellidoBox" Padding="8" Background="#F9FAFB"/>
                    </StackPanel>
                </Grid>

                <!-- Fecha Nacimiento y Ciudad -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Fecha de Nacimiento" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="FechaNacimientoBox" Padding="8" Background="#F9FAFB"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Ciudad *" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CiudadCombo" Padding="8" Background="#F9FAFB" 
                                 IsEditable="True" IsTextSearchEnabled="True" 
                                 DisplayMemberPath="Nombre" TextSearch.TextPath="Nombre"/>
                    </StackPanel>
                </Grid>

                <!-- Email y Teléfono -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Email" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="EmailBox" Padding="8" Background="#F9FAFB"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Teléfono" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TelefonoBox" Padding="8" Background="#F9FAFB"/>
                    </StackPanel>
                </Grid>

                <!-- Dirección -->
                <StackPanel>
                    <TextBlock Text="Dirección" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="DireccionBox" Padding="8" Background="#F9FAFB"/>
                </StackPanel>

                <!-- Notas Clínicas -->
                <StackPanel>
                    <TextBlock Text="Notas Clínicas (Alergias, Condiciones Especiales)" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="NotasBox" Padding="8" Height="100" TextWrapping="Wrap" 
                            VerticalScrollBarVisibility="Auto" Background="#F9FAFB"/>
                </StackPanel>

                <TextBlock Text="* Campos obligatorios" FontSize="12" Foreground="#999999" Margin="0,10,0,0"/>
            </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Guardar" Padding="15,8" Background="#22C55E" Foreground="White"
                   Click="Guardar_Click" MinWidth="100" Margin="0,0,10,0"/>
            <Button Content="Cancelar" Padding="15,8" Background="#6B7280" Foreground="White"
                   Click="Cancelar_Click" MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
