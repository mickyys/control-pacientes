<Window x:Class="ControlPacientes.UI.Views.PacientesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Pacientes" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <TextBlock Text="Gestión de Pacientes" FontSize="20" FontWeight="Bold" 
                   Foreground="#1E3A8A" Margin="0,0,0,15" Grid.Row="0"/>

        <!-- Panel de búsqueda -->
        <Border Grid.Row="1" Margin="0,0,0,15" Background="White" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Buscar por:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0" Padding="8" 
                        VerticalAlignment="Center" Foreground="#333333"
                        TextChanged="SearchBox_TextChanged"/>
                
                <TextBlock Grid.Row="1" Text="Ciudad:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <ComboBox x:Name="CiudadCombo" Grid.Row="1" Grid.Column="1" Margin="10,10,0,0" Padding="8"
                         SelectionChanged="CiudadCombo_SelectionChanged"/>
                
                <Button Grid.Row="1" Grid.Column="2" Content="Nuevo Paciente" Margin="10,10,5,0" 
                       Padding="10" Background="#22C55E" Foreground="White" 
                       Click="NuevoPaciente_Click"/>
                
                <Button Grid.Row="1" Grid.Column="3" Content="Limpiar" Margin="5,10,5,0" 
                       Padding="10" Background="#6B7280" Foreground="White"
                       Click="Limpiar_Click"/>
                       
                <Button Grid.Row="1" Grid.Column="4" Content="Actualizar" Margin="5,10,0,0" 
                       Padding="10" Background="#3B82F6" Foreground="White"
                       Click="Actualizar_Click"/>
            </Grid>
        </Border>

        <!-- Grid de pacientes -->
        <DataGrid Grid.Row="2" x:Name="PacientesGrid" AutoGenerateColumns="False" 
                 IsReadOnly="True" Background="White" GridLinesVisibility="Horizontal"
                 MouseDoubleClick="PacienteSeleccionado_Click" RowHeight="35">
            <DataGrid.Columns>
                <DataGridTextColumn Header="RUT" Binding="{Binding Rut}" Width="120"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="150"/>
                <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" Width="150"/>
                <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="120"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120"/>
                <DataGridTextColumn Header="Acciones" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Panel inferior -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,0" 
                   HorizontalAlignment="Right">
            <Button Content="Editar" Padding="15,8" Background="#3B82F6" Foreground="White"
                   Click="Editar_Click" MinWidth="80" Margin="0,0,10,0"/>
            <Button Content="Eliminar" Padding="15,8" Background="#EF4444" Foreground="White"
                   Click="Eliminar_Click" MinWidth="80" Margin="0,0,10,0"/>
            <Button Content="Cerrar" Padding="15,8" Background="#6B7280" Foreground="White"
                   Click="Cerrar_Click" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
