<Window x:Class="ControlPacientes.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control de Pacientes" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="20">
            <!-- Encabezado -->
            <TextBlock Text="CONTROL DE PACIENTES" 
                       FontSize="28" FontWeight="Bold" 
                       Foreground="#1E3A8A" Margin="0,0,0,20"/>
            
            <TextBlock Text="Sistema de Gestión Médica Offline" 
                       FontSize="14" Foreground="#666666" Margin="0,0,0,30"/>
            
            <!-- Botones principales -->
            <Grid HorizontalAlignment="Stretch" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Gestionar Pacientes -->
                <Border Grid.Column="0" Margin="10" Background="White" 
                       Padding="20">
                    <StackPanel MouseDown="AbrirPacientes_Click"
                               Style="{StaticResource ButtonStackPanelStyle}">
                        <TextBlock Text="👥" FontSize="48" TextAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Gestionar Pacientes" FontSize="16" FontWeight="Bold" TextAlignment="Center"/>
                        <TextBlock Text="Crear, editar y buscar pacientes" FontSize="12" 
                                  Foreground="#666666" TextAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Fichas Médicas -->
                <Border Grid.Column="1" Margin="10" Background="White" 
                       Padding="20">
                    <StackPanel MouseDown="AbrirFichas_Click"
                               Style="{StaticResource ButtonStackPanelStyle}">
                        <TextBlock Text="📋" FontSize="48" TextAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Fichas Médicas" FontSize="16" FontWeight="Bold" TextAlignment="Center"/>
                        <TextBlock Text="Crear y actualizar historiales" FontSize="12" 
                                  Foreground="#666666" TextAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Reportes -->
                <Border Grid.Column="2" Margin="10" Background="White" 
                       Padding="20"
                       Style="{StaticResource ButtonStackPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="📊" FontSize="48" TextAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Reportes" FontSize="16" FontWeight="Bold" TextAlignment="Center"/>
                        <TextBlock Text="Ver estadísticas y reportes" FontSize="12" 
                                  Foreground="#666666" TextAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
            </Grid>
            
            <!-- Info adicional -->
            <Border Margin="0,40,0,0" Background="White" 
                   Padding="20">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="ℹ️ Información del Sistema" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="InfoText" Text="Cargando información..." Foreground="#666666"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
    
    <Window.Resources>
        <Style x:Key="ButtonStackPanelStyle" TargetType="StackPanel">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F2F7"/>
                </Trigger>
            </Style.Triggers>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
</Window>
