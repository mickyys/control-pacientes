# .gitignore para proyecto WPF (.NET 8) - Visual Studio

# Visual Studio
.vs/
.vscode/

# Rider / ReSharper
.idea/
_ReSharper*/
*.DotSettings.user

# Build outputs
bin/
obj/
out/
publish/
artifacts/

# Visual Studio user files
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
packages/
.nuget/

# Test results / coverage
TestResults/
coverage/
*.coverage
*.coveragexml

# Publish / profiles
PublishProfiles/
*.publishsettings

# Secrets / local settings / certs
secrets.json
local.settings.json
appsettings.Development.json
*.pfx
*.key

# Databases / caches
*.db
*.sqlite
*.db-journal

# Logs / temp
*.log
*.tmp
*.temp
~$*

# OS
.DS_Store
Thumbs.db
ehthumbs.db

# Generated / tooling
project.lock.json
project.fragment.lock.json
*.class
*.dll.config

# Node / frontend (si existe)
node_modules/

# Mantener el .gitignore en el repo
!.gitignore
